includes:
    - %currentWorkingDirectory%/vendor/a8cteam51/team51-configs/quality-assurance/phpstan.dist.neon

parameters:
    scanDirectories:
        - %currentWorkingDirectory%/plugins
    paths:
        - %currentWorkingDirectory%/mu-plugins/codelag-blocks
    bootstrapFiles:
        # Shared constant / type stubs across theme + plugins — see
        # type-def.php at wp-content root.
        - %currentWorkingDirectory%/type-def.php
    WPCompat:
        pluginFile: %currentWorkingDirectory%/mu-plugins/codelag-blocks/codelag-blocks.php
